# Скопируйте в .env.local и заполните. Все значения ниже — публичные (попадают в браузер).
# Доступ к данным защищён правилами RLS в базе, а не секретностью этих ключей.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=ваш-anon-или-publishable-ключ

# Публичный VAPID-ключ для Web Push (npx web-push generate-vapid-keys). Без него push отключены.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Подпапка сайта. Для GitHub Pages задаётся автоматически в workflow (/имя-репозитория).
NEXT_PUBLIC_BASE_PATH=
