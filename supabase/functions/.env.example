# Секреты Edge Function send-push. В облаке задаются командой:
#   npx supabase secrets set --env-file supabase/functions/.env
# НЕ коммитьте файл .env с реальными значениями.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
PUSH_WEBHOOK_SECRET=длинная-случайная-строка
APP_URL=https://g-andl.github.io/test
